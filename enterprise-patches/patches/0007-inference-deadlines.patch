@@ -0,0 +1,168 @@
+// Compiled defaults: untrusted project config and environment cannot extend these limits.
+type Limits = { headers: number; first: number; idle: number; total: number }
+const defaults: Readonly<Limits> = Object.freeze({ headers: 30_000, first: 120_000, idle: 60_000, total: 600_000 })
+type Send = (input: string | URL | Request, init?: RequestInit) => Promise<Response>
+
+/** Dependency injection is for tests; the enterprise transport always uses the compiled defaults. */
+export function create(send: Send, limits: Limits = defaults) {
+  return async (input: string | URL | Request, init: RequestInit, streaming: boolean) => {
+    const abort = new AbortController()
+    const state = {
+      finished: false,
+      progress: false,
+      reader: undefined as Pick<ReadableStreamDefaultReader<Uint8Array>, "read" | "cancel" | "releaseLock"> | undefined,
+      body: undefined as ReadableStreamDefaultController<Uint8Array> | undefined,
+      headers: undefined as ReturnType<typeof setTimeout> | undefined,
+      first: undefined as ReturnType<typeof setTimeout> | undefined,
+      idle: undefined as ReturnType<typeof setTimeout> | undefined,
+      total: undefined as ReturnType<typeof setTimeout> | undefined,
+    }
+    const failure = Promise.withResolvers<never>()
+    // A deadline may fire between pulls, when nobody is awaiting the rejection yet.
+    void failure.promise.catch(() => {})
+    const signal = init.signal ?? (input instanceof Request ? input.signal : undefined)
+    const onAbort = () => stop(signal?.reason ?? new DOMException("Inference cancelled", "AbortError"))
+    const cleanup = () => {
+      clearTimeout(state.headers)
+      clearTimeout(state.first)
+      clearTimeout(state.idle)
+      clearTimeout(state.total)
+      signal?.removeEventListener("abort", onAbort)
+    }
+    const stop = (reason: unknown) => {
+      if (state.finished) return
+      state.finished = true
+      cleanup()
+      abort.abort(reason)
+      failure.reject(reason)
+      state.body?.error(reason)
+      // Never await cancellation: a broken stream must not defeat the deadline itself.
+      if (state.reader) {
+        void state.reader.cancel(reason).catch(() => {})
+        state.reader.releaseLock()
+        state.reader = undefined
+      }
+    }
+    const deadline = (stage: keyof Limits) =>
+      setTimeout(
+        () => stop(new DOMException(`Enterprise inference ${stage} deadline exceeded`, "TimeoutError")),
+        limits[stage],
+      )
+    const progress = () => {
+      state.progress = true
+      clearTimeout(state.first)
+      clearTimeout(state.idle)
+      state.idle = deadline("idle")
+    }
+    signal?.addEventListener("abort", onAbort, { once: true })
+    if (signal?.aborted) {
+      onAbort()
+      throw signal.reason
+    }
+    state.headers = deadline("headers")
+    state.total = deadline("total")
+    try {
+      const pending = send(input, { ...init, signal: abort.signal }).then((response) => {
+        // Also release a late response from a non-cooperative fetch implementation.
+        if (state.finished) void response.body?.cancel(abort.signal.reason).catch(() => {})
+        return response
+      })
+      const response = await Promise.race([pending, failure.promise])
+      clearTimeout(state.headers)
+      state.reader = response.body?.getReader()
+      if (response.status >= 300 && response.status < 400) throw new Error("Enterprise transport rejects redirects")
+      if (response.ok) {
+        const type = response.headers.get("content-type")?.split(";")[0]?.trim().toLowerCase()
+        if (type !== (streaming ? "text/event-stream" : "application/json"))
+          throw new Error("Enterprise inference returned a missing or unexpected Content-Type")
+        if (!state.reader) throw new Error("Enterprise inference returned an empty response body")
+      }
+      if (!state.reader) {
+        state.finished = true
+        cleanup()
+        return response
+      }
+      const reader = state.reader
+      const observe = streaming && response.ok ? eventProgress(progress) : progress
+      state.first = deadline("first")
+      const body = new ReadableStream<Uint8Array>({
+        start(controller) {
+          state.body = controller
+        },
+        async pull(controller) {
+          try {
+            const chunk = await Promise.race([reader.read(), failure.promise])
+            if (state.finished) return
+            if (chunk.done) {
+              if (response.ok && !state.progress) throw new Error("Enterprise inference ended before model output")
+              state.finished = true
+              cleanup()
+              reader.releaseLock()
+              controller.close()
+              return
+            }
+            if (chunk.value.byteLength) observe(chunk.value)
+            controller.enqueue(chunk.value)
+          } catch (error) {
+            stop(error)
+          }
+        },
+        cancel(reason) {
+          stop(reason ?? new DOMException("Inference response cancelled", "AbortError"))
+        },
+      })
+      return new Response(body, { status: response.status, statusText: response.statusText, headers: response.headers })
+    } catch (error) {
+      stop(error)
+      throw error
+    }
+  }
+}
+
+// Keepalives and role-only deltas must not extend time-to-first-token or idle deadlines.
+function eventProgress(progress: () => void) {
+  const decoder = new TextDecoder()
+  const state = { buffer: "", data: "" }
+  return (chunk: Uint8Array) => {
+    state.buffer += decoder.decode(chunk, { stream: true })
+    if (state.buffer.length + state.data.length > 1024 * 1024)
+      throw new Error("Enterprise inference SSE event exceeds 1 MiB")
+    const lines = state.buffer.split(/\r\n|\r(?!$)|\n/)
+    state.buffer = lines.pop() ?? ""
+    for (const line of lines) {
+      if (line.startsWith("data:")) state.data += `${line.slice(5).trimStart()}\n`
+      if (line !== "") continue
+      const data = state.data.trim()
+      state.data = ""
+      if (!data) continue
+      if (data === "[DONE]") {
+        progress()
+        continue
+      }
+      // The SDK owns protocol validation. This observer only recognizes model progress.
+      const value: unknown = JSON.parse(data)
+      if (!value || typeof value !== "object") continue
+      if ("error" in value) {
+        progress()
+        continue
+      }
+      if (!("choices" in value) || !Array.isArray(value.choices)) continue
+      if (
+        value.choices.some((choice: unknown) => {
+          if (!choice || typeof choice !== "object") return false
+          if ("finish_reason" in choice && choice.finish_reason != null) return true
+          if (!("delta" in choice) || !choice.delta || typeof choice.delta !== "object") return false
+          return Object.entries(choice.delta).some(
+            ([key, value]) =>
+              key !== "role" && value != null && value !== "" && (!Array.isArray(value) || value.length > 0),
+          )
+        })
+      )
+        progress()
+    }
+  }
+}
+
+// Resolve fetch when sending, so the runtime's standard TLS trust and proxy policy apply.
+export const fetch = create((input, init) => globalThis.fetch(input, init))
+export * as InferenceDeadline from "./inference-deadline"
