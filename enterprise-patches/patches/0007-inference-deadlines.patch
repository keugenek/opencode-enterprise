-    if (response.status >= 300 && response.status < 400) throw new Error("Enterprise transport rejects redirects")
-    return response
+    return InferenceDeadline.fetch(
+      input,
+      {
+        method: "POST",
+        body: init?.body,
+        signal: init?.signal,
+        headers: { "content-type": "application/json", accept: "application/json, text/event-stream" },
+        redirect: "error",
+        credentials: "omit",
+      },
+      "stream" in body && body.stream === true,
+    )
   }
   return Object.assign(send, { preconnect: () => {} })
 }
diff --git a/packages/core/test/enterprise/transport-deadlines.test.ts b/packages/core/test/enterprise/transport-deadlines.test.ts
new file mode 100644
index 0000000..2e268e8
--- /dev/null
+++ b/packages/core/test/enterprise/transport-deadlines.test.ts
@@ -0,0 +1,342 @@
+import { describe, expect, test } from "bun:test"
+import { InferenceDeadline } from "../../src/enterprise/inference-deadline"
+
+const limits = { headers: 80, first: 80, idle: 80, total: 500 }
+const input = "https://inference.internal/v1/chat/completions"
+const init = { method: "POST", body: '{"model":"enterprise-coder","stream":true}' }
+const headers = { "content-type": "text/event-stream; charset=utf-8" }
+const token = 'data: {"choices":[{"delta":{"content":"hello"}}]}\n\n'
+const encode = (value: string) => new TextEncoder().encode(value)
+const pause = (milliseconds: number) => new Promise((resolve) => setTimeout(resolve, milliseconds))
+describe("enterprise inference deadlines", () => {
+  test("aborts stalled headers without retrying", async () => {
+    const state = { calls: 0, aborted: false }
+    const send = InferenceDeadline.create((_input, request) => {
+      state.calls++
+      return new Promise<Response>((_resolve, reject) => {
+        request?.signal?.addEventListener("abort", () => {
+          state.aborted = true
+          reject(request.signal?.reason)
+        })
+      })
+    }, limits)
+    await expect(send(input, init, true)).rejects.toThrow("headers deadline")
+    expect(state).toEqual({ calls: 1, aborted: true })
+  })
+
+  test("cancels a late response even when fetch ignores its abort signal", async () => {
+    const state = { cancelled: false }
+    const response = new Response(
+      new ReadableStream({
+        cancel() {
+          state.cancelled = true
+        },
+      }),
+      { headers },
+    )
+    const send = InferenceDeadline.create(
+      async () => {
+        await pause(100)
+        return response
+      },
+      { ...limits, headers: 20 },
+    )
+    await expect(send(input, init, true)).rejects.toThrow("headers deadline")
+    await pause(120)
+    expect(state.cancelled).toBe(true)
+  })
+
+  test.each([undefined, "text/plain", "application/json"])(
+    "rejects missing/wrong streaming MIME %s and cancels the body",
+    async (type) => {
+      const state = { cancelled: false, signal: undefined as AbortSignal | undefined }
+      const send = InferenceDeadline.create(async (_input, request) => {
+        state.signal = request?.signal ?? undefined
+        return new Response(
+          new ReadableStream({
+            cancel() {
+              state.cancelled = true
+            },
+          }),
+          {
+            headers: type ? { "content-type": type } : {},
+          },
+        )
+      }, limits)
+      await expect(send(input, init, true)).rejects.toThrow("Content-Type")
+      expect(state.cancelled).toBe(true)
+      expect(state.signal?.aborted).toBe(true)
+    },
+  )
+
+  test("expires a stream with no chunks and closes the underlying reader", async () => {
+    const state = { cancelled: false }
+    const send = InferenceDeadline.create(
+      async () =>
+        new Response(
+          new ReadableStream({
+            cancel() {
+              state.cancelled = true
+            },
+          }),
+          { headers },
+        ),
+      limits,
+    )
+    const response = await send(input, init, true)
+    await expect(response.text()).rejects.toThrow("first deadline")
+    expect(state.cancelled).toBe(true)
+  })
+
+  test("rejects an immediate empty stream instead of reporting success", async () => {
+    const send = InferenceDeadline.create(async () => new Response("", { headers }), limits)
+    const response = await send(input, init, true)
+    await expect(response.text()).rejects.toThrow("ended before model output")
+  })
+
+  test("role deltas and SSE keepalives cannot satisfy the first-token deadline", async () => {
+    const state = { cancelled: false }
+    const send = InferenceDeadline.create(
+      async () =>
+        new Response(
+          periodic(': ping\n\ndata: {"choices":[{"delta":{"role":"assistant"}}]}\n\n', () => {
+            state.cancelled = true
+          }),
+          { headers },
+        ),
+      limits,
+    )
+    const response = await send(input, init, true)
+    await expect(response.text()).rejects.toThrow("first deadline")
+    expect(state.cancelled).toBe(true)
+  })
+
+  test("expires stalled generation after the first model token despite keepalives", async () => {
+    const send = InferenceDeadline.create(
+      async () =>
+        new Response(
+          periodic(": ping\n\n", () => {}, token),
+          { headers },
+        ),
+      limits,
+    )
+    const response = await send(input, init, true)
+    await expect(response.text()).rejects.toThrow("idle deadline")
+  })
+
+  test("total deadline terminates a stream that keeps producing tokens", async () => {
+    const send = InferenceDeadline.create(async () => new Response(periodic(token), { headers }), {
+      ...limits,
+      total: 120,
+    })
+    const response = await send(input, init, true)
+    await expect(response.text()).rejects.toThrow("total deadline")
+  })
+
+  test("caller cancellation interrupts a pending body read", async () => {
+    const abort = new AbortController()
+    const state = { cancelled: false, signal: undefined as AbortSignal | undefined }
+    const send = InferenceDeadline.create(async (_input, request) => {
+      state.signal = request?.signal ?? undefined
+      return new Response(
+        new ReadableStream({
+          cancel() {
+            state.cancelled = true
+          },
+        }),
+        { headers },
+      )
+    }, limits)
+    const response = await send(input, { ...init, signal: abort.signal }, true)
+    const pending = response.text()
+    abort.abort(new Error("user cancelled"))
+    await expect(pending).rejects.toThrow("user cancelled")
+    expect(state.cancelled).toBe(true)
+    expect(state.signal?.aborted).toBe(true)
+  })
+
+  test("does not send a request when already cancelled", async () => {
+    const send = InferenceDeadline.create(async () => {
+      throw new Error("must not fetch")
+    }, limits)
+    await expect(
+      send(input, { ...init, signal: AbortSignal.abort(new Error("already cancelled")) }, true),
+    ).rejects.toThrow("already cancelled")
+  })
+
+  test("downstream cancellation aborts inference and releases the source", async () => {
+    const state = { cancelled: false, signal: undefined as AbortSignal | undefined }
+    const send = InferenceDeadline.create(async (_input, request) => {
+      state.signal = request?.signal ?? undefined
+      return new Response(
+        new ReadableStream({
+          cancel() {
+            state.cancelled = true
+          },
+        }),
+        { headers },
+      )
+    }, limits)
+    const response = await send(input, init, true)
+    await response.body?.cancel()
+    expect(state.cancelled).toBe(true)
+    expect(state.signal?.aborted).toBe(true)
+  })
+
+  test("a hanging source cancel cannot hang downstream cancellation", async () => {
+    const source = new ReadableStream({ cancel: () => new Promise<void>(() => {}) })
+    const send = InferenceDeadline.create(async () => new Response(source, { headers }), limits)
+    const response = await send(input, init, true)
+    await response.body?.cancel()
+    expect(source.locked).toBe(false)
+  })
+
+  test("unexpected upstream closure propagates and aborts the request", async () => {
+    const state = { signal: undefined as AbortSignal | undefined }
+    const send = InferenceDeadline.create(async (_input, request) => {
+      state.signal = request?.signal ?? undefined
+      return new Response(
+        new ReadableStream({
+          start(controller) {
+            controller.error(new Error("upstream connection closed"))
+          },
+        }),
+        { headers },
+      )
+    }, limits)
+    const response = await send(input, init, true)
+    await expect(response.text()).rejects.toThrow("upstream connection closed")
+    expect(state.signal?.aborted).toBe(true)
+  })
+
+  test("non-streaming JSON and bounded error messages remain readable", async () => {
+    for (const status of [200, 503]) {
+      const data = '{"message":"fixture"}'
+      const send = InferenceDeadline.create(
+        async () =>
+          new Response(data, {
+            status,
+            headers: { "content-type": "application/json; charset=utf-8" },
+          }),
+        limits,
+      )
+      const response = await send(input, init, false)
+      expect(response.status).toBe(status)
+      expect(await response.text()).toBe(data)
+    }
+  })
+
+  test("redirect responses are rejected and their bodies cancelled", async () => {
+    const state = { cancelled: false }
+    const send = InferenceDeadline.create(
+      async () =>
+        new Response(
+          new ReadableStream({
+            cancel() {
+              state.cancelled = true
+            },
+          }),
+          { status: 307, headers: { location: "https://api.openai.com/" } },
+        ),
+      limits,
+    )
+    await expect(send(input, init, true)).rejects.toThrow("rejects redirects")
+    expect(state.cancelled).toBe(true)
+  })
+
+  test("cleans up timers after a complete stream and preserves its exact bytes", async () => {
+    const data = `${token}data: [DONE]\n\n`
+    const state = { signal: undefined as AbortSignal | undefined }
+    const send = InferenceDeadline.create(async (_input, request) => {
+      state.signal = request?.signal ?? undefined
+      return new Response(data, { headers })
+    }, limits)
+    const response = await send(input, init, true)
+    expect(await response.text()).toBe(data)
+    await pause(100)
+    expect(state.signal?.aborted).toBe(false)
+  })
+
+  test("handles UTF-8 and SSE events fragmented across transport chunks", async () => {
+    const data = encode('data: {"choices":[{"delta":{"content":"привет"}}]}\r\n\r\ndata: [DONE]\r\n\r\n')
+    const send = InferenceDeadline.create(
+      async () =>
+        new Response(
+          new ReadableStream({
+            start(controller) {
+              for (const value of data) controller.enqueue(new Uint8Array([value]))
+              controller.close()
+            },
+          }),
+          { headers },
+        ),
+      limits,
+    )
+    const response = await send(input, init, true)
+    expect(await response.text()).toBe(new TextDecoder().decode(data))
+  })
+
+  test("bounds stalled non-streaming JSON and error bodies too", async () => {
+    for (const status of [200, 503]) {
+      const send = InferenceDeadline.create(
+        async () =>
+          new Response(new ReadableStream(), {
+            status,
+            headers: { "content-type": "application/json" },
+          }),
+        limits,
+      )
+      const response = await send(input, init, false)
+      await expect(response.text()).rejects.toThrow("first deadline")
+    }
+  })
+
+  test("uses actual HTTP fetch: idle timeout closes the network connection", async () => {
+    const closed = Promise.withResolvers<void>()
+    const server = Bun.serve({
+      hostname: "127.0.0.1",
+      port: 0,
+      fetch(request) {
+        request.signal.addEventListener("abort", () => closed.resolve(), { once: true })
+        return new Response(
+          new ReadableStream({
+            start(controller) {
+              controller.enqueue(encode(token))
+            },
+            cancel() {
+              closed.resolve()
+            },
+          }),
+          { headers },
+        )
+      },
+    })
+    try {
+      const send = InferenceDeadline.create((input, request) => fetch(input, request), limits)
+      const response = await send(`${server.url}v1/chat/completions`, init, true)
+      await expect(response.text()).rejects.toThrow("idle deadline")
+      await Promise.race([
+        closed.promise,
+        pause(500).then(() => {
+          throw new Error("Connection was not closed")
+        }),
+      ])
+    } finally {
+      await server.stop(true)
+    }
+  })
+})
+
+function periodic(data: string, cancel = () => {}, first = "") {
+  const state = { timer: undefined as ReturnType<typeof setInterval> | undefined }
+  return new ReadableStream<Uint8Array>({
+    start(controller) {
+      if (first) controller.enqueue(encode(first))
+      state.timer = setInterval(() => controller.enqueue(encode(data)), 10)
+    },
+    cancel() {
+      clearInterval(state.timer)
+      cancel()
+    },
+  })
+}
