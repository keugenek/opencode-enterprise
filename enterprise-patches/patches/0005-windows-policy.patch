diff --git a/packages/core/src/enterprise/windows.ts b/packages/core/src/enterprise/windows.ts
new file mode 100644
index 0000000..87ba536
--- /dev/null
+++ b/packages/core/src/enterprise/windows.ts
@@ -0,0 +1,60 @@
+import { execFileSync } from "node:child_process"
+
+// Deliberately fixed: neither environment variables nor project configuration
+// may select the policy or the executable that verifies its Windows ACLs.
+export const file = String.raw`C:\Program Files\OpenCode Enterprise\enterprise.json`
+const script = String.raw`
+$ErrorActionPreference = 'Stop'
+$PSModuleAutoLoadingPreference = 'None'
+try {
+  [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
+  $trusted = @('S-1-5-18', 'S-1-5-32-544', 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464')
+  $paths = @('C:\', 'C:\Program Files', 'C:\Program Files\OpenCode Enterprise', 'C:\Program Files\OpenCode Enterprise\enterprise.json')
+  foreach ($path in $paths) {
+    $attributes = [IO.File]::GetAttributes($path)
+    if ($attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Policy path contains a reparse point' }
+    $directory = ($attributes -band [IO.FileAttributes]::Directory) -ne 0
+    if ($directory -ne ($path -ne $paths[3])) { throw 'Invalid policy path type' }
+    $acl = if ($directory) { [IO.Directory]::GetAccessControl($path) } else { [IO.File]::GetAccessControl($path) }
+    if ($trusted -notcontains $acl.GetOwner([Security.Principal.SecurityIdentifier]).Value) { throw 'Untrusted policy owner' }
+    $rules = $acl.GetAccessRules($true, $true, [Security.Principal.SecurityIdentifier])
+    if ($rules.Count -eq 0) { throw 'Missing policy DACL' }
+    # Ancestors may permit creation of unrelated directories, but not replacement
+    # or changes to ownership/ACLs. The policy directory and file reject all writes.
+    $mask = 0x000D0040
+    if ($path -eq $paths[2] -or $path -eq $paths[3]) { $mask = $mask -bor 0x00000116 }
+    # Also reject unmapped GENERIC_ALL / GENERIC_WRITE rights.
+    $mask = $mask -bor 0x50000000
+    foreach ($rule in $rules) {
+      if ($rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) { continue }
+      if ($rule.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow) { continue }
+      if ($trusted -contains $rule.IdentityReference.Value) { continue }
+      if ([long]$rule.FileSystemRights -band $mask) { throw 'Policy path grants untrusted write or replacement rights' }
+    }
+  }
+  $info = [IO.FileInfo]::new($paths[3])
+  if ($info.Length -gt 16384) { throw 'Policy exceeds 16 KiB' }
+  [Console]::Write([IO.File]::ReadAllText($paths[3], [Text.Encoding]::UTF8))
+} catch {
+  [Console]::Error.WriteLine('Enterprise Windows policy rejected: ' + $_.Exception.Message)
+  exit 1
+}
+`
+
+export function read() {
+  return execFileSync(
+    String.raw`C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe`,
+    ["-NoLogo", "-NoProfile", "-NonInteractive", "-EncodedCommand", Buffer.from(script, "utf16le").toString("base64")],
+    {
+      cwd: String.raw`C:\Windows\System32`,
+      env: { SystemRoot: String.raw`C:\Windows`, WINDIR: String.raw`C:\Windows` },
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "pipe"],
+      timeout: 10000,
+      maxBuffer: 65536,
+      windowsHide: true,
+    },
+  )
+}
+
+export * as WindowsPolicy from "./windows"
