-    expect(validStoreName("opencode.settings.dat")).toBe(true)
-    expect(validStoreName("opencode.window.123.dat")).toBe(true)
+  test("IPC permits actual renderer default, global, window, workspace, session and draft stores", () => {
+    const names = [
+      "default.dat", // createPlatform.storage() default for settings.v3/app-version.v1/highlights.v1
+      SETTINGS_STORE,
+      "opencode.settings.dat",
+      "opencode.updater",
+      Persist.global("language").storage,
+      PersistTesting.windowStorage("f89ecbde-2353-4163-84a8-5042b22be48d"),
+      PersistTesting.windowStorage("browser"),
+      Persist.draft("draft-a", "prompt").storage,
+    ]
+    for (const directory of [
+      "C:\\Users\\Alice\\project",
+      "C:/Users/Alice/project",
+      "/home/alice/project",
+      "\\\\host\\share\\project",
+      "",
+    ]) {
+      const workspace = Persist.workspace(directory, "terminal")
+      names.push(
+        workspace.storage,
+        ...(workspace.legacyStorageNames ?? []),
+        Persist.session(directory, "ses_test", "layout").storage,
+      )
+    }
+    for (const name of names) {
+      expect(name).toBeDefined()
+      expect(validStoreName(name!)).toBe(true)
+    }
+  })
+  test("IPC store names cannot escape application state directory or select Windows alternate streams", () => {
     for (const name of [
       "../enterprise.json",
       "C:\\Program Files\\OpenCode Enterprise\\enterprise.json",
       "opencode/../../policy",
       "opencode..evil",
+      "default.dat/../policy",
+      "default.dat\\..\\policy",
+      "default.dat:credentials",
+      "default.dat::$DATA",
+      "default.dat.",
+      "default.dat ",
+      "default.dat\u0000",
+      "default.dat\n",
+      "default2.dat",
+      "/default.dat",
+      "C:default.dat",
+      "\\\\host\\share\\default.dat",
+      "opencode.settings:credentials",
+      "opencode.settings::$DATA",
+      "opencode.settings\u0000",
+      "opencode.settings\n",
+      "opencode.settings\r\n",
+      "opencode.settings\nmalicious",
+      "CON",
+      "NUL.dat",
     ])
       expect(validStoreName(name)).toBe(false)
   })
