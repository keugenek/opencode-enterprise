diff --git a/packages/app/src/context/global-sync/bootstrap.test.ts b/packages/app/src/context/global-sync/bootstrap.test.ts
index a95706a..9aa55df 100644
--- a/packages/app/src/context/global-sync/bootstrap.test.ts
+++ b/packages/app/src/context/global-sync/bootstrap.test.ts
@@ -327,4 +327,32 @@ describe("query keys", () => {
     expect(calls).toEqual([{ location: { directory: "/repo" } }])
     expect(result).toHaveLength(1)
   })
+
+  test("enterprise reference queries return empty without contacting either API", async () => {
+    const calls: string[] = []
+    const api = {
+      list: async () => {
+        calls.push("current")
+        throw new Error("Reference endpoint must not be requested")
+      },
+    } as unknown as ReferenceApi
+    const legacy = {
+      v2: {
+        reference: {
+          list: async () => {
+            calls.push("legacy")
+            throw new Error("Legacy reference endpoint must not be requested")
+          },
+        },
+      },
+    } as unknown as OpencodeClient
+    for (const protocol of ["v1", "v2"] as const) {
+      expect(
+        await new QueryClient().fetchQuery(
+          loadReferencesQuery(ServerScope.local, "/repo", api, legacy, Promise.resolve(protocol), true),
+        ),
+      ).toEqual([])
+    }
+    expect(calls).toEqual([])
+  })
 })
