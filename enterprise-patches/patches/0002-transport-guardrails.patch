diff --git a/packages/core/src/enterprise/transport.ts b/packages/core/src/enterprise/transport.ts
new file mode 100644
index 0000000..07dbb70
--- /dev/null
+++ b/packages/core/src/enterprise/transport.ts
@@ -0,0 +1,44 @@
+import { Enterprise } from "./policy"
+
+export function validate(policy: Enterprise.Document, input: string | URL | Request, init?: RequestInit) {
+  const url = new URL(input instanceof Request ? input.url : input)
+  if (url.href !== `${policy.baseURL}/chat/completions` || init?.method?.toUpperCase() !== "POST")
+    throw new Error("Enterprise transport only permits the fixed chat-completions endpoint")
+  if (typeof init.body !== "string") throw new Error("Enterprise transport requires a JSON request")
+  const body: unknown = JSON.parse(init.body)
+  if (!body || typeof body !== "object" || !("model" in body) || body.model !== policy.model)
+    throw new Error("Enterprise transport rejected a model override")
+  if (init.body.length > 16 * 1024 * 1024) throw new Error("Enterprise request exceeds 16 MiB")
+  // vLLM can fetch remote media itself; keep this initial coding profile text-only.
+  const inspect = (value: unknown): void => {
+    if (!value || typeof value !== "object") return
+    if (Array.isArray(value)) return value.forEach(inspect)
+    for (const [key, child] of Object.entries(value)) {
+      if (["image_url", "input_image", "video_url", "audio_url", "file_url"].includes(key))
+        throw new Error("Remote media is disabled in the enterprise coding profile")
+      inspect(child)
+    }
+  }
+  if ("messages" in body) inspect(body.messages)
+}
+
+export function create(policy: Enterprise.Document) {
+  const send = async (input: string | URL | Request, init?: RequestInit) => {
+    validate(policy, input, init)
+    // The gateway authenticates the workload (e.g. service-mesh mTLS). No personal/cloud credentials.
+    // Do not forward SDK/user cookies, authorization, proxy options, or caller TLS overrides.
+    const response = await fetch(input, {
+      method: "POST",
+      body: init?.body,
+      signal: init?.signal,
+      headers: { "content-type": "application/json", accept: "application/json, text/event-stream" },
+      redirect: "error",
+      credentials: "omit",
+    })
+    if (response.status >= 300 && response.status < 400) throw new Error("Enterprise transport rejects redirects")
+    return response
+  }
+  return Object.assign(send, { preconnect: () => {} })
+}
+
+export * as EnterpriseTransport from "./transport"
