index a1e3448..4e172f9 100644
--- a/packages/app/src/components/prompt-input/build-request-parts.ts
+++ b/packages/app/src/components/prompt-input/build-request-parts.ts
@@ -1,3 +1,4 @@
+import { enterprise } from "@/utils/enterprise"
 import { getFilename } from "@opencode-ai/core/util/path"
 import { type AgentPartInput, type FilePartInput, type Part, type TextPartInput } from "@opencode-ai/sdk/v2/client"
 import type { FileSelection } from "@/context/file"
@@ -8,6 +9,24 @@ import { createCommentMetadata, formatCommentNote } from "@/utils/comment-note"
 
 type PromptRequestPart = (TextPartInput | FilePartInput | AgentPartInput) & { id: string }
 
+// References remain plain text: only the agent's approved tools may read workspace files.
+// Do not let browser context silently invoke server-side file/source resolution.
+export function enterpriseRequestParts(parts: PromptRequestPart[]): PromptRequestPart[] {
+  return parts.flatMap<PromptRequestPart>((part) => {
+    if (part.type === "text") return [{ id: part.id, type: "text", text: part.text }]
+    if (part.type !== "file") return []
+    if (part.url.startsWith("file:") && URL.canParse(part.url)) {
+      const url = new URL(part.url)
+      return [{ id: part.id, type: "text", text: `@${decodeURI(url.pathname)}${url.search}` }]
+    }
+    if (/^data:text\/plain;base64,/.test(part.url)) {
+      const text = new TextDecoder().decode(Uint8Array.from(atob(part.url.split(",")[1]), (char) => char.charCodeAt(0)))
+      return [{ id: part.id, type: "text", text: `${part.filename ?? ""}\n${text}` }]
+    }
+    return []
+  })
+}
+
 type ContextFile = {
   key: string
   type: "file"
