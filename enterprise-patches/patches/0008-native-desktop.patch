new file mode 100644
index 0000000..f17d054
--- /dev/null
+++ b/packages/app/src/utils/enterprise.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, test } from "bun:test"
+import { enterpriseAsset, enterpriseCommandAllowed } from "./enterprise"
+
+describe("enterprise browser policy", () => {
+  test("native desktop retains local terminal commands without opening cloud or disabled worktree controls", () => {
+    for (const id of ["terminal.toggle", "terminal.new", "prompt.mode.shell"]) {
+      expect(enterpriseCommandAllowed(id, true)).toBe(true)
+    }
+    for (const id of [
+      "provider.connect",
+      "server.switch",
+      "model.choose",
+      "permissions.autoaccept",
+      "session.share",
+      "workspace.new",
+      "workspace.toggle",
+    ]) {
+      expect(enterpriseCommandAllowed(id, true)).toBe(false)
+    }
+  })
+  test("blocks cloud configuration, direct shell, auto-approval and sharing commands", () => {
+    for (const id of [
+      "provider.connect",
+      "server.switch",
+      "model.choose",
+      "terminal.toggle",
+      "workspace.new",
+      "session.share",
+      "session.unshare",
+      "permissions.autoaccept",
+      "prompt.mode.shell",
+      "suggested.provider.connect",
+    ]) {
+      expect(enterpriseCommandAllowed(id)).toBe(false)
+    }
+    for (const id of ["session.new", "session.previous", "file.open", "settings.open", "review.toggle"]) {
+      expect(enterpriseCommandAllowed(id)).toBe(true)
+    }
+  })
+
+  test("accepts local assets but rejects remote URLs, URL credentials and active data", () => {
+    const origin = "https://code.internal"
+    expect(enterpriseAsset("/favicon-v3.svg", origin)).toBe(`${origin}/favicon-v3.svg`)
+    expect(enterpriseAsset("data:image/png;base64,YQ==", origin)).toBe("data:image/png;base64,YQ==")
+    for (const value of [
+      "https://opencode.ai/favicon.svg",
+      "//external.test/pixel",
+      "https://user:password@code.internal/a",
+      "data:image/svg+xml,<svg/>",
+      "javascript:alert(1)",
+    ]) {
+      expect(enterpriseAsset(value, origin)).toBeUndefined()
+    }
+  })
+})
diff --git a/packages/app/src/utils/enterprise.ts b/packages/app/src/utils/enterprise.ts
new file mode 100644
index 0000000..4b57a87
--- /dev/null
+++ b/packages/app/src/utils/enterprise.ts
@@ -0,0 +1,26 @@
+// A build-time presentation policy. The server independently enforces every restriction.
+export const enterprise = import.meta.env.VITE_OPENCODE_ENTERPRISE === "true"
+export const enterpriseDesktop = enterprise && import.meta.env.VITE_OPENCODE_ENTERPRISE_DESKTOP === "true"
+
+export function enterpriseCommandAllowed(id: string, desktop = enterpriseDesktop) {
+  const action = id.replace(/^suggested\./, "")
+  if (desktop && ["terminal.", "prompt.mode.shell"].some((prefix) => action.startsWith(prefix))) return true
+  return ![
+    "provider.",
+    "server.",
+    "model.",
+    "terminal.",
+    "workspace.",
+    "session.share",
+    "session.unshare",
+    "permissions.autoaccept",
+    "prompt.mode.shell",
+  ].some((prefix) => action.startsWith(prefix))
+}
+
+export function enterpriseAsset(source: string | undefined, origin: string) {
+  if (!source) return
+  if (/^data:image\/(?:png|jpeg|gif|webp);base64,/.test(source)) return source
+  const url = URL.canParse(source, origin) ? new URL(source, origin) : undefined
+  if (url?.origin === origin && !url.username && !url.password) return url.href
+}
