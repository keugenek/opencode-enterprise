+import { describe, expect, test } from "bun:test"
+import { fileURLToPath } from "node:url"
+import yargs from "yargs"
+import { TuiThreadCommand } from "../../src/cli/cmd/tui"
+
+describe("enterprise console transport", () => {
+  test("TUI parser rejects every public-listener spelling before its handler", async () => {
+    const cases = [
+      ["--port", "4096"],
+      ["--port=4096"],
+      ["--hostname", "0.0.0.0"],
+      ["--hostname=0.0.0.0"],
+      ["--mdns"],
+      ["--no-mdns"],
+      ["--mdns=false"],
+      ["--mdns-domain", "remote.local"],
+      ["--mdnsDomain=remote.local"],
+      ["--cors", "https://untrusted.example"],
+      ["--mini", "--port=4096"],
+    ]
+    for (const input of cases) {
+      let invoked = false
+      const parser = yargs([])
+        .command({
+          ...TuiThreadCommand,
+          handler: () => {
+            invoked = true
+          },
+        })
+        .strict()
+        .exitProcess(false)
+        .fail((message, error) => {
+          throw error ?? new Error(message)
+        })
+      await expect(Promise.resolve().then(() => parser.parseAsync(input))).rejects.toThrow("Unknown argument")
+      expect(invoked).toBe(false)
+    }
+  })
+
+  test("normal TUI worker serves its internal API but cannot open a network listener", async () => {
+    const worker = new Worker(new URL("./fixtures/tui-network-worker.ts", import.meta.url).href)
+    try {
+      const result = await new Promise<{ status: number; error: string }>((resolve, reject) => {
+        worker.onmessage = (event) => resolve(event.data)
+        worker.onerror = (event) => reject(new Error(event.message))
+      })
+      expect(result.status).toBe(200)
+      expect(result.error).toContain("Enterprise TUI network listeners are disabled")
+    } finally {
+      worker.terminate()
+    }
+  }, 30000)
+
+  test("run --attach is denied before any request reaches the remote server", async () => {
+    let requests = 0
+    const server = Bun.serve({
+      hostname: "127.0.0.1",
+      port: 0,
+      fetch() {
+        requests++
+        return Response.json({ healthy: true, version: "untrusted" })
+      },
+    })
+    try {
+      const child = Bun.spawn(
+        [
+          process.execPath,
+          fileURLToPath(new URL("../../src/index.ts", import.meta.url)),
+          "run",
+          "--attach",
+          server.url.toString(),
+          "--model",
+          "openai/cloud-model",
+          "private prompt",
+        ],
+        {
+          stdin: "ignore",
+          stdout: "pipe",
+          stderr: "pipe",
+        },
+      )
+      const [exit, out, err] = await Promise.all([
+        child.exited,
+        new Response(child.stdout).text(),
+        new Response(child.stderr).text(),
+      ])
+      expect(exit).not.toBe(0)
+      expect(out + err).toContain("Remote --attach is disabled by enterprise policy")
+      expect(requests).toBe(0)
+    } finally {
+      server.stop(true)
+    }
+  }, 30000)
+})
