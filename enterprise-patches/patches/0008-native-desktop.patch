+describe("enterprise request parts", () => {
+  test("turns file references into text without triggering server file resolution", () => {
+    expect(
+      enterpriseRequestParts([
+        {
+          id: "text",
+          type: "text",
+          text: "Review these files",
+          synthetic: true,
+          ignored: true,
+          metadata: { injected: true },
+        },
+        {
+          id: "file",
+          type: "file",
+          mime: "text/plain",
+          url: "file:///workspace/src/a.ts?start=1&end=4",
+          filename: "a.ts",
+          source: { type: "file", path: "/secret", text: { value: "@a.ts", start: 0, end: 5 } },
+        },
+      ]),
+    ).toEqual([
+      { id: "text", type: "text", text: "Review these files" },
+      { id: "file", type: "text", text: "@/workspace/src/a.ts?start=1&end=4" },
+    ])
+  })
+
+  test("converts uploaded text to user text and drops images, agents and remote resources", () => {
+    expect(
+      enterpriseRequestParts([
+        { id: "text", type: "file", mime: "text/plain", url: "data:text/plain;base64,aGVsbG8=", filename: "a.txt" },
+        { id: "image", type: "file", mime: "image/png", url: "data:image/png;base64,YQ==", filename: "a.png" },
+        { id: "remote", type: "file", mime: "text/plain", url: "https://outside.example/secret" },
+        { id: "agent", type: "agent", name: "unsafe", source: { value: "@unsafe", start: 0, end: 7 } },
+      ]),
+    ).toEqual([{ id: "text", type: "text", text: "a.txt\nhello" }])
