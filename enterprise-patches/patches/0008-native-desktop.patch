+import { createHash, timingSafeEqual } from "node:crypto"
+import { Effect } from "effect"
+import { HttpServerRequest, HttpServerResponse } from "effect/unstable/http"
+import { Enterprise } from "@opencode-ai/core/enterprise/policy"
+
+export type Credentials = { username: string; password: string }
+export function validate(input: Credentials & { hostname: string; port: number }) {
+  Enterprise.read()
+  if (
+    input.hostname !== "127.0.0.1" ||
+    !Number.isInteger(input.port) ||
+    input.port < 1 ||
+    input.port > 65535 ||
+    input.username !== "opencode" ||
+    input.password.length < 24
+  )
+    throw new Error("ERR_ENTERPRISE_DESKTOP_LISTENER")
+}
+
+function digest(value: string) {
+  return createHash("sha256").update(value).digest()
+}
+
+function blocked(path: string, method: string) {
+  if (method === "GET" && ["/experimental/session", "/experimental/worktree"].includes(path)) return false
+  if (/^\/(?:api|auth|sync|console|experimental|workspace)(?:\/|$)/.test(path)) return true
+  if (/^\/global\/(?:upgrade|dispose)$/.test(path)) return true
+  if (/^\/provider\/[^/]+\/(?:oauth|auth)/.test(path)) return true
+  if (/^\/session\/[^/]+\/share$/.test(path)) return true
+  if (
+    ["PATCH", "POST", "PUT", "DELETE"].includes(method) &&
+    /^\/(?:mcp|provider|config|global\/config)(?:\/|$)/.test(path)
+  )
+    return true
+  return false
+}
+
+export function middleware(credentials: Credentials, port: number) {
+  const authorization = digest(
+    `Basic ${Buffer.from(`${credentials.username}:${credentials.password}`).toString("base64")}`,
+  )
+  return <E, R>(effect: Effect.Effect<HttpServerResponse.HttpServerResponse, E, R>) =>
+    Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest
+      const url = new URL(request.url, `http://127.0.0.1:${port}`)
+      const pathname = url.pathname.toLowerCase()
+      const deny = (status = 403) => HttpServerResponse.jsonUnsafe({ error: "Enterprise desktop policy" }, { status })
+      if (request.headers.host !== `127.0.0.1:${port}`) return deny()
+      const origin = request.headers.origin
+      if (origin && origin !== "oc://renderer") return deny()
+      if (request.headers["sec-fetch-site"] === "cross-site" && origin !== "oc://renderer") return deny()
+      if (request.method === "OPTIONS") {
+        if (origin !== "oc://renderer") return deny()
+        return HttpServerResponse.empty({
+          status: 204,
+          headers: {
+            "access-control-allow-origin": "oc://renderer",
+            "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
+            "access-control-allow-headers": "authorization, content-type, x-opencode-directory, x-opencode-ticket",
+            vary: "Origin",
+          },
+        })
+      }
+      if (!timingSafeEqual(authorization, digest(request.headers.authorization ?? ""))) return deny(401)
+      if (
+        /[\\%;]/.test(url.pathname) ||
+        url.pathname.includes("//") ||
+        (url.pathname !== "/" && url.pathname.endsWith("/")) ||
+        url.searchParams.has("auth_token") ||
+        url.searchParams.has("workspace") ||
+        url.searchParams.has("workspaceID") ||
+        request.headers["x-opencode-workspace"] ||
+        blocked(pathname, request.method)
+      )
+        return deny()
+      if (request.method === "GET" && ["/mcp", "/provider/auth"].includes(pathname))
+        return HttpServerResponse.jsonUnsafe({})
+      if (request.method === "GET" && ["/lsp", "/formatter", "/skill"].includes(pathname))
+        return HttpServerResponse.jsonUnsafe([])
+      // Legacy API permits per-session permission/tool changes and model choice.
+      // The native client keeps ordinary sessions, but cannot loosen the compiled policy.
+      if (["POST", "PATCH"].includes(request.method) && /^\/session(?:\/|$)/.test(pathname)) {
+        const body = yield* request.text
+        const value: unknown = body
+          ? yield* Effect.try({ try: () => JSON.parse(body) as unknown, catch: () => undefined }).pipe(
+              Effect.orElseSucceed(() => undefined),
+            )
+          : {}
+        if (!value || typeof value !== "object" || Array.isArray(value)) return deny(400)
+        const payload = value as Record<string, unknown>
+        if (["permission", "permissions", "tools", "workspaceID"].some((key) => key in payload)) return deny()
+        const selected = payload.model
+        if (selected !== undefined) {
+          if (typeof selected === "string") {
+            if (!pathname.endsWith("/command") || selected !== `enterprise/${Enterprise.read().model}`) return deny()
+          } else {
+            if (!selected || typeof selected !== "object" || Array.isArray(selected)) return deny()
+            const model = selected as Record<string, unknown>
+            if (model.providerID !== "enterprise" || model.modelID !== Enterprise.read().model) return deny()
+          }
+        }
+        if (
+          payload.providerID !== undefined &&
+          (payload.providerID !== "enterprise" || payload.modelID !== Enterprise.read().model)
+        )
+          return deny()
+      }
+      const response = yield* effect
+      return HttpServerResponse.setHeader(response, "cache-control", "no-store")
+    }).pipe(
+      Effect.map((response) =>
+        HttpServerResponse.setHeaders(response, {
+          "access-control-allow-origin": "oc://renderer",
+          vary: "Origin",
+          "cache-control": "no-store",
+        }),
+      ),
+    )
+}
+
+export * as EnterpriseDesktop from "./enterprise-desktop"
