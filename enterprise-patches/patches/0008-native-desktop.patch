+import { describe, expect, test } from "bun:test"
+import { Effect } from "effect"
+import { HttpServerRequest, HttpServerResponse } from "effect/unstable/http"
+import { EnterpriseDesktop } from "../../src/server/enterprise-desktop"
+
+const credentials = { username: "opencode", password: "desktop-random-credential-at-least-24" }
+const authorization = `Basic ${Buffer.from(`${credentials.username}:${credentials.password}`).toString("base64")}`
+const boundary = EnterpriseDesktop.middleware(credentials, 49165)
+const endpoint = Effect.gen(function* () {
+  const request = yield* HttpServerRequest.HttpServerRequest
+  return HttpServerResponse.text(request.method === "POST" ? yield* request.text : "ok")
+})
+async function call(path: string, init: RequestInit = {}) {
+  const request = new Request(`http://127.0.0.1:49165${path}`, {
+    ...init,
+    headers: { host: "127.0.0.1:49165", authorization, ...Object.fromEntries(new Headers(init.headers)) },
+  })
+  return Effect.runPromise(
+    boundary(endpoint).pipe(
+      Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(request)),
+    ),
+  )
+}
+
+describe("native desktop sidecar middleware", () => {
+  test("authenticates API, events, UI assets and PTY tickets", async () => {
+    for (const path of [
+      "/provider",
+      "/global/health",
+      "/event",
+      "/global/event",
+      "/site.webmanifest",
+      "/pty/id/connect?ticket=x",
+    ]) {
+      expect((await call(path, { headers: { authorization: "" } })).status).toBe(401)
+    }
+  })
+  test("rejects foreign origins/hosts and credential query strings", async () => {
+    expect((await call("/provider", { headers: { origin: "https://attacker.invalid" } })).status).toBe(403)
+    expect((await call("/provider", { headers: { host: "attacker.invalid" } })).status).toBe(403)
+    expect((await call("/provider?auth_token=x")).status).toBe(403)
+    expect((await call("/provider", { headers: { origin: "oc://renderer" } })).status).toBe(200)
+    expect((await call("/mcp", { headers: { origin: "oc://renderer" } })).headers["access-control-allow-origin"]).toBe(
+      "oc://renderer",
+    )
+  })
+  test("blocks remote/control/config/cloud routes before handlers", async () => {
+    for (const [path, method] of [
+      ["/api/session", "GET"],
+      ["/experimental/console", "GET"],
+      ["/sync", "POST"],
+      ["/global/upgrade", "POST"],
+      ["/mcp", "POST"],
+      ["/config", "PATCH"],
+      ["/auth/openai", "PUT"],
+      ["/provider/openai/oauth/authorize", "POST"],
+      ["/session?workspace=remote", "GET"],
+    ]) {
+      expect((await call(path!, { method })).status).toBe(403)
+    }
+  })
+  test("rejects router normalization aliases before dispatch", async () => {
+    for (const route of ["/global/upgrade/", "/GLOBAL/upgrade", "/global/upgrade;a=b", "/MCP", "/api/session/"]) {
+      expect((await call(route, { method: "POST", body: "{}" })).status).toBe(403)
+    }
+    expect(
