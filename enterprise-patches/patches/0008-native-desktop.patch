+import { describe, expect, test } from "bun:test"
+import {
+  enterpriseRequest,
+  enterpriseSidecarEnv,
+  enterpriseCsp,
+  setEnterpriseConnection,
+  validStoreName,
+} from "./enterprise"
+
+describe("native enterprise boundary", () => {
+  test("renderer can reach only bundled assets and its exact authenticated sidecar", () => {
+    setEnterpriseConnection({ url: "http://127.0.0.1:41965", password: "per-launch-credential-with-32-bytes" })
+    expect(enterpriseRequest("oc://renderer/index.html")).toEqual({ allowed: true })
+    expect(enterpriseRequest("http://127.0.0.1:41965/provider").authorization).toContain("Basic ")
+    expect(enterpriseRequest("ws://127.0.0.1:41965/pty/a/connect").authorization).toContain("Basic ")
+    for (const url of [
+      "https://opencode.ai",
+      "https://telemetry.invalid",
+      "http://localhost:41965",
+      "http://127.0.0.1:41966",
+      "https://127.0.0.1:41965",
+      "oc://foreign/index.html",
+    ]) {
+      expect(enterpriseRequest(url).allowed).toBe(false)
+    }
+    expect(enterpriseCsp()).toContain("connect-src 'self' http://127.0.0.1:41965 ws://127.0.0.1:41965")
+    expect(enterpriseCsp()).not.toContain("connect-src *")
+  })
+  test("sidecar environment cannot select V2, leak authentication or inject a remote renderer", () => {
+    const result = enterpriseSidecarEnv(
+      {
+        OPENCODE_SERVER_PASSWORD: "secret",
+        OPENCODE_SERVER_USERNAME: "user",
+        OPENCODE_SIDECAR_V2: "1",
+        ELECTRON_RENDERER_URL: "https://attacker.invalid",
+        OPENCODE_WORKSPACE_ID: "remote",
+        NODE_OPTIONS: "--require attack.js",
+        PATH: "/tools",
+      },
+      "/desktop/state",
+    )
+    expect(result.OPENCODE_SIDECAR_V2).toBe("0")
+    expect(result.OPENCODE_EXPERIMENTAL_ICON_DISCOVERY).toBe("false")
+    expect(result).not.toHaveProperty("OPENCODE_SERVER_PASSWORD")
+    expect(result).not.toHaveProperty("OPENCODE_SERVER_USERNAME")
+    expect(result).not.toHaveProperty("NODE_OPTIONS")
+    expect(result).not.toHaveProperty("ELECTRON_RENDERER_URL")
+    expect(result).not.toHaveProperty("OPENCODE_WORKSPACE_ID")
+    expect(result.PATH).toBe("/tools")
+  })
+  test("IPC store names cannot escape application state directory", () => {
+    expect(validStoreName("opencode.settings.dat")).toBe(true)
+    expect(validStoreName("opencode.window.123.dat")).toBe(true)
+    for (const name of [
+      "../enterprise.json",
+      "C:\\Program Files\\OpenCode Enterprise\\enterprise.json",
+      "opencode/../../policy",
+      "opencode..evil",
+    ])
+      expect(validStoreName(name)).toBe(false)
+  })
+})
diff --git a/packages/desktop/src/main/enterprise.ts b/packages/desktop/src/main/enterprise.ts
new file mode 100644
index 0000000..e0186c7
--- /dev/null
+++ b/packages/desktop/src/main/enterprise.ts
@@ -0,0 +1,54 @@
+export const ENTERPRISE = import.meta.env?.OPENCODE_ENTERPRISE === true
+
+type Connection = { url: string; password: string }
+let connection: Connection | undefined
+
+export function setEnterpriseConnection(value: Connection) {
+  const url = new URL(value.url)
+  if (url.protocol !== "http:" || url.hostname !== "127.0.0.1" || !url.port || value.password.length < 24)
+    throw new Error("ERR_ENTERPRISE_SIDECAR_CONNECTION")
+  connection = { url: url.origin, password: value.password }
+}
+
+export function enterpriseRequest(value: string) {
+  const url = new URL(value)
+  if (url.protocol === "oc:" && url.host === "renderer") return { allowed: true }
+  if (["data:", "blob:"].includes(url.protocol)) return { allowed: true }
+  if (!connection) return { allowed: false }
+  const endpoint = new URL(connection.url)
+  if (!["http:", "ws:"].includes(url.protocol) || url.host !== endpoint.host) return { allowed: false }
+  return { allowed: true, authorization: `Basic ${Buffer.from(`opencode:${connection.password}`).toString("base64")}` }
+}
+
+export function enterpriseSidecarEnv(input: NodeJS.ProcessEnv, userDataPath: string) {
+  const env = Object.fromEntries(
+    Object.entries(input).flatMap(([key, value]) => (value === undefined ? [] : [[key, value]])),
+  )
+  for (const key of [
+    "OPENCODE_SERVER_PASSWORD",
+    "OPENCODE_SERVER_USERNAME",
+    "OPENCODE_WORKSPACE_ID",
+    "OPENCODE_PORT",
+    "ELECTRON_RENDERER_URL",
+    "NODE_OPTIONS",
+    "NODE_PATH",
+    "DEBUG",
+  ])
+    delete env[key]
+  return {
+    ...env,
+    OPENCODE_SIDECAR_V2: "0",
+    OPENCODE_EXPERIMENTAL_ICON_DISCOVERY: "false",
+    OPENCODE_DISABLE_EMBEDDED_WEB_UI: "true",
+    XDG_STATE_HOME: userDataPath,
+  }
+}
+
+export function validStoreName(name: string) {
+  return /^opencode[\w.-]{0,180}$/.test(name) && !name.includes("..")
+}
+
+export function enterpriseCsp() {
+  const endpoint = connection?.url ?? "http://127.0.0.1:1"
+  return `default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${endpoint} ${endpoint.replace("http:", "ws:")}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'`
+}
