+import { describe, expect, spyOn } from "bun:test"
+import { Cause, Effect, Exit, Layer, Stream } from "effect"
+import path from "node:path"
+import { pathToFileURL } from "node:url"
+import { AppNodeBuilder } from "@opencode-ai/core/effect/app-node-builder"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { SessionProjector } from "@opencode-ai/core/session/projector"
+import { Agent } from "@/agent/agent"
+import { Provider } from "@/provider/provider"
+import { LLM } from "@/session/llm"
+import { SessionPrompt } from "@/session/prompt"
+import { Session } from "@/session/session"
+import { TestInstance, testInstanceStoreLayer } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+// Real prompt persistence and AI SDK conversion, with no model server required.
+// The administrator-owned policy is installed by the enterprise CI fixture.
+const it = testEffect(
+  Layer.mergeAll(
+    AppNodeBuilder.build(
+      LayerNode.group([SessionPrompt.node, Session.node, SessionProjector.node, Provider.node, Agent.node, LLM.node]),
+    ),
+    testInstanceStoreLayer,
+  ),
+)
+
+describe("enterprise attachment egress", () => {
+  it.instance("rejects remote attachments before saving the user message", () =>
+    Effect.gen(function* () {
+      const prompt = yield* SessionPrompt.Service
+      const sessions = yield* Session.Service
+      const session = yield* sessions.create({ title: "Attachment boundary" })
+      for (const url of [
+        "https://attacker.invalid/document.txt",
+        "http://169.254.169.254/latest/meta-data/",
+        "http://127.0.0.1:1234/private",
+        "file://remote-host/share/document.txt",
+        "file:////remote-host/share/document.txt",
+        "file:///%5c%5cremote-host/share/document.txt",
+        "data:application/octet-stream;base64,aGVsbG8=",
+      ]) {
+        const exit = yield* prompt
+          .prompt({
+            sessionID: session.id,
+            noReply: true,
+            parts: [{ type: "file", mime: "text/plain", url }],
+          })
+          .pipe(Effect.exit)
+        expect(Exit.isFailure(exit)).toBe(true)
+        if (Exit.isFailure(exit)) expect(String(Cause.squash(exit.cause))).toContain("Enterprise policy")
+      }
+      const resource = yield* prompt
+        .prompt({
+          sessionID: session.id,
+          noReply: true,
+          parts: [
+            {
+              type: "file",
+              mime: "text/plain",
+              url: "data:text/plain,placeholder",
+              source: {
+                type: "resource",
+                clientName: "remote",
+                uri: "https://attacker.invalid/resource",
+                text: { value: "resource", start: 0, end: 8 },
+              },
+            },
+          ],
+        })
+        .pipe(Effect.exit)
+      expect(Exit.isFailure(resource)).toBe(true)
+      if (Exit.isFailure(resource))
+        expect(String(Cause.squash(resource.cause))).toContain("remote resource attachments")
+      expect(yield* sessions.messages({ sessionID: session.id })).toHaveLength(0)
+    }),
+  )
+
+  it.instance("preserves developer-selected local text and inline text attachments", () =>
+    Effect.gen(function* () {
+      const instance = yield* TestInstance
+      const prompt = yield* SessionPrompt.Service
+      const sessions = yield* Session.Service
+      const session = yield* sessions.create({ title: "Local attachments" })
+      const file = path.join(instance.directory, "notes.txt")
+      yield* Effect.promise(() => Bun.write(file, "local enterprise source"))
+      const message = yield* prompt.prompt({
+        sessionID: session.id,
+        noReply: true,
+        parts: [
+          { type: "file", mime: "text/plain", filename: "notes.txt", url: pathToFileURL(file).href },
+          {
+            type: "file",
+            mime: "text/plain",
+            filename: "inline.txt",
+            url: "data:text/plain;base64,aW5saW5lIGVudGVycHJpc2Ugc291cmNl",
+          },
+        ],
+      })
+      const text = message.parts
+        .filter((part) => part.type === "text")
+        .map((part) => part.text)
+        .join("\n")
+      expect(text).toContain("local enterprise source")
+      expect(text).toContain("inline enterprise source")
+    }),
+  )
+
+  it.instance("real LLM SDK rejects historical remote URLs before its global fetch", () =>
+    Effect.gen(function* () {
+      const prompt = yield* SessionPrompt.Service
+      const sessions = yield* Session.Service
+      const provider = yield* Provider.Service
+      const agents = yield* Agent.Service
+      const llm = yield* LLM.Service
+      const session = yield* sessions.create({ title: "Historical attachment" })
+      const message = yield* prompt.prompt({
+        sessionID: session.id,
+        noReply: true,
+        parts: [{ type: "text", text: "Read the historical attachment" }],
+      })
+      if (message.info.role !== "user") throw new Error("Expected user message")
+      const model = yield* provider.getModel(message.info.model.providerID, message.info.model.modelID)
+      const agent = yield* agents.defaultInfo()
+      const fetch = yield* Effect.acquireRelease(
+        Effect.sync(() =>
+          spyOn(globalThis, "fetch").mockImplementation(
+            Object.assign(
+              async () => {
+                throw new Error("unexpected SDK attachment network request")
+              },
+              { preconnect: globalThis.fetch.preconnect },
+            ),
+          ),
+        ),
+        (fetch) => Effect.sync(() => fetch.mockRestore()),
+      )
+      for (const mime of ["application/octet-stream", "application/pdf", "image/png"]) {
+        const exit = yield* llm
+          .stream({
+            user: message.info,
+            sessionID: session.id,
+            model,
+            agent,
+            system: [],
+            tools: {},
+            retries: 0,
+            messages: [
+              {
+                role: "user",
+                content: [{ type: "file", data: new URL("https://attacker.invalid/history"), mediaType: mime }],
+              },
+            ],
+          })
+          .pipe(Stream.runDrain, Effect.exit)
+        expect(Exit.isFailure(exit)).toBe(true)
+        if (Exit.isFailure(exit))
+          expect(String(Cause.squash(exit.cause))).toContain("Enterprise policy denies remote attachment downloads")
+      }
+      expect(fetch).not.toHaveBeenCalled()
+    }),
+  )
+})
