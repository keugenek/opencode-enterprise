+import { expect, test } from "bun:test"
+import { downloadCliToResources, resolveChannel } from "./utils"
+
+test("enterprise has its own installer identity and no upstream executable or publisher", async () => {
+  const previous = process.env.OPENCODE_CHANNEL
+  process.env.OPENCODE_CHANNEL = "enterprise"
+  try {
+    expect(resolveChannel()).toBe("enterprise")
+    const { default: config } = await import("../electron-builder.config.ts?enterprise-build")
+    expect(config.appId).toBe("io.github.keugenek.opencode.enterprise")
+    expect(config.productName).toBe("OpenCode Enterprise Desktop")
+    expect(config.publish).toBeNull()
+    expect(config.protocols).toEqual([])
+    expect(config.extraResources).toEqual([])
+    expect(config.nsis?.perMachine).toBe(true)
+    expect(config.forceCodeSigning).toBe(false)
+    expect(config.artifactName).toContain("opencode-enterprise-desktop-")
+    await expect(downloadCliToResources()).rejects.toThrow("cannot download an upstream CLI")
+  } finally {
+    if (previous === undefined) delete process.env.OPENCODE_CHANNEL
+    else process.env.OPENCODE_CHANNEL = previous
+  }
+})
