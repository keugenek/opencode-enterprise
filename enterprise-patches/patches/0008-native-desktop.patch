   return {
-    requestParts,
-    optimisticParts: requestParts.map((part) => toOptimisticPart(part, input.sessionID, input.messageID)),
+    requestParts: parts,
+    optimisticParts: parts.map((part) => toOptimisticPart(part, input.sessionID, input.messageID)),
   }
 }
