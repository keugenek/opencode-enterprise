+import { describe, expect, test } from "bun:test"
+import { Schema } from "effect"
+import { Enterprise } from "../../src/enterprise/policy"
+import { EnterpriseTransport } from "../../src/enterprise/transport"
+import { ConfigV1 } from "../../src/v1/config/config"
+import { Otlp } from "../../src/observability/otlp"
+
+const policy = { baseURL: "https://inference.internal/v1", model: "enterprise-coder", context: 32768, output: 8192 }
+const request = {
+  method: "POST",
+  body: JSON.stringify({ model: policy.model, messages: [{ role: "user", content: "test" }] }),
+}
+
+describe("immutable enterprise policy", () => {
+  test("validates the deployment policy and the actual OpenCode config schema", () => {
+    expect(Enterprise.decode(JSON.stringify(policy))).toEqual(policy)
+    expect(() => Schema.decodeUnknownSync(ConfigV1.Info)(Enterprise.config(policy))).not.toThrow()
+    expect(Object.keys(Enterprise.config(policy).provider)).toEqual(["enterprise"])
+    expect(Enterprise.config(policy).small_model).toBe("enterprise/enterprise-coder")
+  })
+  test.each([
+    "http://inference.internal/v1",
+    "https://user:password@inference.internal/v1",
+    "https://inference.internal/v1?url=evil",
+    "https://inference.internal/v1#evil",
+    "https://inference.internal/v2",
+  ])("rejects endpoint %s", (baseURL) => {
+    expect(() => Enterprise.decode(JSON.stringify({ ...policy, baseURL }))).toThrow()
+  })
+  test.each(["", "a;b", "a b", "../#evil"])("rejects ambiguous model ID %s", (model) => {
+    expect(() => Enterprise.decode(JSON.stringify({ ...policy, model }))).toThrow()
+  })
+  test("does not reuse mutated config objects", () => {
+    const config = Enterprise.config(policy)
+    config.provider.enterprise.options.baseURL = "https://evil.example/v1"
+    expect(Enterprise.config(policy).provider.enterprise.options.baseURL).toBe(policy.baseURL)
+  })
+  test.each(["webfetch", "websearch", "codesearch", "external_directory", "mcp_test", "mcp.test", "lsp", "skill"])(
+    "mandatory deny: %s",
+    (tool) => {
+      expect(Enterprise.denied(tool)).toBe(true)
+    },
+  )
+  test("keeps the coding tools available for permission checks", () => {
+    for (const tool of ["read", "edit", "bash", "glob", "grep", "task"]) expect(Enterprise.denied(tool)).toBe(false)
+  })
+})
+
+describe("inference transport before network I/O", () => {
+  test("accepts only the configured model and endpoint", () => {
+    expect(() => EnterpriseTransport.validate(policy, `${policy.baseURL}/chat/completions`, request)).not.toThrow()
+  })
+  test.each([
+    "https://api.openai.com/v1/chat/completions",
+    "https://inference.internal.evil/v1/chat/completions",
+    "https://inference.internal/v1/responses",
+    "https://inference.internal/v1/chat/completions?target=evil",
+    "http://169.254.169.254/latest/meta-data",
+  ])("rejects route %s", (url) => {
+    expect(() => EnterpriseTransport.validate(policy, url, request)).toThrow()
+  })
+  test("blocks model injection and non-JSON bodies", () => {
+    expect(() =>
+      EnterpriseTransport.validate(policy, `${policy.baseURL}/chat/completions`, {
+        ...request,
+        body: '{"model":"gpt-cloud"}',
+      }),
+    ).toThrow()
+    expect(() =>
+      EnterpriseTransport.validate(policy, `${policy.baseURL}/chat/completions`, { method: "GET" }),
+    ).toThrow()
+  })
+  test("blocks inference-server remote media fetching", () => {
+    const body = JSON.stringify({
+      model: policy.model,
+      messages: [{ content: [{ image_url: { url: "http://169.254.169.254/" } }] }],
+    })
+    expect(() =>
+      EnterpriseTransport.validate(policy, `${policy.baseURL}/chat/completions`, { ...request, body }),
+    ).toThrow()
+  })
+  test("has no OTLP log exporters or identity attributes", () => {
+    expect(Otlp.loggers()).toEqual([])
+    expect(Otlp.resource().attributes).toEqual({})
+  })
+})
