+++ b/packages/core/src/enterprise/policy.ts
@@ -0,0 +1,96 @@
+import { lstatSync, readFileSync } from "node:fs"
+import { Schema } from "effect"
+
+// This patch series is a Linux CLI distribution, not a user-switchable mode.
+export const enabled: boolean = true
+export const file = "/etc/opencode/enterprise.json"
+export const ProviderID = "enterprise"
+const Document = Schema.Struct({
+  baseURL: Schema.String,
+  model: Schema.String,
+  context: Schema.Int,
+  output: Schema.Int,
+})
+export type Document = typeof Document.Type
+
+export function decode(text: string) {
+  const value = Schema.decodeUnknownSync(Schema.fromJsonString(Document))(text)
+  const url = new URL(value.baseURL)
+  if (url.protocol !== "https:" || url.username || url.password || url.search || url.hash || url.pathname !== "/v1")
+    throw new Error("Enterprise endpoint must be HTTPS with an exact /v1 path and no credentials or query")
+  if (!/^[a-zA-Z0-9._/-]{1,160}$/.test(value.model)) throw new Error("Invalid enterprise model ID")
+  if (value.context < 4096 || value.output < 1 || value.output > value.context || value.output > 32768)
+    throw new Error("Invalid enterprise token limits")
+  return value
+}
+
+export function read() {
+  if (process.platform !== "linux") throw new Error("Enterprise distribution requires the managed Linux runtime")
+  for (const name of ["/etc", "/etc/opencode", file]) {
+    const stat = lstatSync(name)
+    if (stat.isSymbolicLink() || stat.uid !== 0 || (stat.mode & 0o022) !== 0)
+      throw new Error("Enterprise policy and its parents must be root-owned, not symlinks, and not group/world writable")
+    if (name === file && (!stat.isFile() || stat.size > 16384)) throw new Error("Invalid enterprise policy file")
+  }
+  return decode(readFileSync(file, "utf8"))
+}
+
+export function selection(provider: string, model: string) {
+  const value = read()
+  if (provider !== ProviderID || model !== value.model) throw new Error("Model blocked by enterprise policy")
+  return value
+}
+
+// These denies are a floor, including for subagents and saved approvals.
+export function denied(tool: string) {
+  return ["webfetch", "websearch", "codesearch", "external_directory", "lsp", "skill"].includes(tool) ||
+    tool.startsWith("mcp_") || tool.startsWith("mcp.")
+}
+
+export function config() {
+  const value = read()
+  const model = `${ProviderID}/${value.model}`
+  return {
+    model,
+    small_model: model,
+    enabled_providers: [ProviderID],
+    provider: {
+      [ProviderID]: {
+        name: "Enterprise inference",
+        npm: "@ai-sdk/openai-compatible",
+        options: { baseURL: value.baseURL, apiKey: "gateway-managed" },
+        models: {
+          [value.model]: {
+            name: value.model,
+            tool_call: true,
+            limit: { context: value.context, output: value.output },
+          },
+        },
+      },
+    },
+    share: "disabled" as const,
+    autoupdate: false as const,
+    plugin: [],
+    mcp: {},
+    lsp: false as const,
+    formatter: false as const,
+    skills: { paths: [], urls: [] },
+    permission: {
+      "*": "ask" as const,
+      read: "allow" as const,
+      glob: "allow" as const,
+      grep: "allow" as const,
+      edit: "ask" as const,
+      bash: "ask" as const,
+      external_directory: "deny" as const,
+      webfetch: "deny" as const,
+      websearch: "deny" as const,
+      codesearch: "deny" as const,
+      lsp: "deny" as const,
+      skill: "deny" as const,
+    },
+    experimental: { openTelemetry: false },
+  }
+}
+
+export * as Enterprise from "./policy"
